# Copy this file to .env and fill it in. Until the email settings are filled in,
# the app runs in "test mode": order emails are printed in the server window
# instead of being sent.

EVENT_NAME=Lemonade Fundraiser
TIMEZONE=America/New_York
PORT=3000

# PIN your volunteers type to open the cashier / queue pages (any username works).
STAFF_PIN=

# --- Email for every new order ---
# Where orders go (you can list several, separated by commas).
ORGANIZER_EMAIL=lrcncsocial@gmail.com
# The Gmail account that sends them. It can be the same account.
# SMTP_PASS is a Gmail App Password (see EMAIL_SETUP.md), not the normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lrcncsocial@gmail.com
SMTP_PASS=
EMAIL_FROM=
