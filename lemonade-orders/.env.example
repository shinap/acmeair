# Copy this file to .env and fill it in. Anything left blank runs in "dry run"
# mode: the message is printed in the server window instead of being sent.

EVENT_NAME=Lemonade Fundraiser
TIMEZONE=America/New_York
PORT=3000

# PIN your volunteers type to open the cashier / queue pages (any username works).
STAFF_PIN=

# --- Texts to customers (Twilio: https://www.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number you own (+15551234567) ...
TWILIO_FROM_NUMBER=
# ... or a Messaging Service SID (MG...), which takes priority if set.
TWILIO_MESSAGING_SERVICE_SID=

# --- Email to you for every new order ---
ORGANIZER_EMAIL=you@example.com
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM=
